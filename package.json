{
  "name": "@plugjs/oxc",
  "version": "0.1.9",
  "description": "OXLint and OXFmt support for PlugJS",
  "keywords": [
    "build",
    "compile",
    "ecmascript",
    "javascript",
    "node",
    "oxc",
    "oxfmt",
    "oxlint",
    "plugjs"
  ],
  "homepage": "https://github.com/plugjs/oxc#readme",
  "bugs": {
    "url": "https://github.com/plugjs/oxc/issues"
  },
  "license": "Apache-2.0",
  "author": "Juit Developers <developers@juit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plugjs/oxc.git"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "*.md",
    "dist/",
    "src/"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./configs/oxfmt": {
      "types": "./dist/configs/oxfmt.d.ts",
      "default": "./dist/configs/oxfmt.js"
    },
    "./configs/oxlint": {
      "types": "./dist/configs/oxlint.d.ts",
      "default": "./dist/configs/oxlint.js"
    },
    "./configs/oxlint.node": {
      "types": "./dist/configs/oxlint.node.d.ts",
      "default": "./dist/configs/oxlint.node.js"
    }
  },
  "scripts": {
    "build": "plug",
    "coverage": "plug coverage",
    "dev": "plug coverage -w src -w test",
    "lint": "plug lint",
    "lintfix": "plug lint fix=true",
    "test": "plug test",
    "transpile": "plug transpile"
  },
  "dependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@plugjs/cov8": "^0.7.7",
    "@plugjs/expect5": "^0.7.7",
    "@plugjs/plug": "^0.7.7",
    "@plugjs/typescript": "^0.7.7"
  },
  "peerDependencies": {
    "@plugjs/plug": "^0.7.7"
  }
}
